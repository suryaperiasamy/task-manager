# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection
# Replace with your local MongoDB URI or MongoDB Atlas string
MONGO_URI=mongodb://localhost:27017/taskmanager

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (For CORS setting in production)
FRONTEND_URL=http://localhost:5173

# Security & Testing Options
# Allow '000000' as a bypass OTP code in development? (Set to false in production!)
ALLOW_OTP_BYPASS=true

# =========================================================================
# EMAIL SERVICE CONFIGURATION
# Choose ONE of the following methods for sending OTP and password reset emails:
# =========================================================================

# METHOD 1: Brevo HTTP API (RECOMMENDED for cloud hosts like Render free tier)
# 1. Sign up for a free account at Brevo.com
# 2. Go to SMTP & API -> API Keys -> Create a new API key
# 3. Add the key here. This uses HTTPS (port 443) which is never blocked by cloud hosts.
BREVO_API_KEY=your_brevo_api_key_here

# METHOD 2: Gmail SMTP App Password (Fallback - often blocked on cloud free tiers)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to Security -> App passwords -> Generate an app password (16 characters)
# 3. Fill in the email and app password here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=suryakpsamy@gmail.com
EMAIL_PASS=szxtckicjmdnqhni
